{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT u.id, u.username, u.email, u.created_at,\n                       u.first_name, u.last_name, u.patronymic, u.email_verified,\n                       u.role as \"role: UserRole\", ac.password_hash as password\n                FROM users u\n                LEFT JOIN auth_credentials ac ON ac.user_id = u.id\n                WHERE u.email = $1\n            ",
